# Copy to keystore.properties (which is git-ignored) and fill in to produce a
# signed release build. Alternatively set SGP_KEYSTORE_FILE,
# SGP_KEYSTORE_PASSWORD, SGP_KEY_ALIAS and SGP_KEY_PASSWORD in the environment.
storeFile=/absolute/path/to/supergenpass-upload.jks
storePassword=
keyAlias=
keyPassword=
